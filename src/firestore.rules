rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             (request.auth.token.email == 'mohabouinany@gmail.com' ||
              request.auth.token.email == 'admin@atlaslabs.it' ||
              request.auth.token.email == 'admin@passioneimmobiliare.it' ||
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Properties validation helper
    function isValidProperty(data) {
      return (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 200)) &&
             (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 10000)) &&
             (!data.keys().hasAny(['price']) || (data.price is number && data.price >= 0)) &&
             (!data.keys().hasAny(['location']) || (data.location is string && data.location.size() <= 200)) &&
             (!data.keys().hasAny(['type']) || (data.type is string && (data.type == 'Appartamento' || data.type == 'Villa' || data.type == 'Terreno' || data.type == 'Commerciale' || data.type == 'Rustico' || data.type == 'Masseria'))) &&
             (!data.keys().hasAny(['status']) || (data.status is string && (data.status == 'Vendita' || data.status == 'Affitto'))) &&
             (!data.keys().hasAny(['bedrooms']) || (data.bedrooms is number && data.bedrooms >= 0)) &&
             (!data.keys().hasAny(['bathrooms']) || (data.bathrooms is number && data.bathrooms >= 0)) &&
             (!data.keys().hasAny(['areaSqM']) || (data.areaSqM is number && data.areaSqM >= 0)) &&
             (!data.keys().hasAny(['coverImage']) || (data.coverImage is string && data.coverImage.size() <= 2000)) &&
             (!data.keys().hasAny(['images']) || (data.images is list && data.images.size() <= 50)) &&
             (!data.keys().hasAny(['features']) || (data.features is list && data.features.size() <= 50)) &&
             (!data.keys().hasAny(['featured']) || (data.featured is bool)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is number));
    }

    match /properties/{propertyId} {
      allow read: if true;
      
      allow create: if isAdmin() &&
                    isValidId(propertyId) &&
                    incoming().keys().hasAll(['title', 'description', 'price', 'location', 'type', 'status', 'bedrooms', 'bathrooms', 'areaSqM', 'coverImage', 'images', 'features', 'featured', 'createdAt']) &&
                    incoming().keys().size() == 14 &&
                    isValidProperty(incoming());
                    
      allow update: if isAdmin() &&
                    isValidId(propertyId) &&
                    isValidProperty(incoming()) &&
                    incoming().createdAt == existing().createdAt;
                    
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    // Messages validation helper
    function isValidMessage(data) {
      return (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 100)) &&
             (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 100)) &&
             (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 50)) &&
             (!data.keys().hasAny(['message']) || (data.message is string && data.message.size() <= 1000)) &&
             (!data.keys().hasAny(['propertyId']) || (data.propertyId is string && data.propertyId.size() <= 64)) &&
             (!data.keys().hasAny(['propertyTitle']) || (data.propertyTitle is string && data.propertyTitle.size() <= 200)) &&
             (!data.keys().hasAny(['status']) || (data.status is string && (data.status == 'Nuovo' || data.status == 'Letto' || data.status == 'Contattato'))) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is number));
    }

    match /messages/{messageId} {
      allow read: if isAdmin();
      
      allow create: if isValidId(messageId) &&
                    incoming().keys().hasAll(['name', 'email', 'phone', 'message', 'createdAt', 'status']) &&
                    incoming().status == 'Nuovo' &&
                    isValidMessage(incoming());
                    
      allow update: if isAdmin() &&
                    isValidId(messageId) &&
                    isValidMessage(incoming()) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().email == existing().email;
                    
      allow delete: if isAdmin() && isValidId(messageId);
    }

    // Allows reading the admin list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable through GCP console
    }
  }
}
